PORT="5000"
BCRYPT_SALT="10"
MONGODB_URL="mongodb://127.0.0.1:27017/<DB_NAME>"
MONGODB_DB_NAME="<DB_NAME>"
REDIS_URL="redis://127.0.0.1:6379"
REDIS_KEY_PREFIX="nest-with-mongodb"
REDIS_DEFAULT_TTL=120
REDIS_LOCAL_TTL=15
REDIS_SNAPSHOT_TTL=180
REDIS_ITEM_TTL=600
REDIS_PAGE_TTL=90
DEFAULT_LANGUAGE="en"
SUPPORTED_LANGUAGES="en,hi"

INCOMING_REQUESTS_LOGGING=0 # -> 0 or 1

JWT_VALIDITY=60m
JWT_SECRET="YOUR-SECRET"
JWT_ALGORITHM="HS256"
