{
  "name": "nest-with-mongodb",
  "version": "0.0.1",
  "description": "",
  "author": "Shubham Kashyap",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch && zip -r archive.zip nest-with-mongodb . -x '*.zip' 'node_modules/*' 'dist/*'",
    "debug": "nest start --debug --watch",
    "prod": "node dist/main",
    "seed": "node -r ts-node/register/transpile-only -r tsconfig-paths/register prisma/seed.ts",
    "seed:list": "node -r ts-node/register/transpile-only -r tsconfig-paths/register prisma/seed.ts --list",
    "seed:user": "node -r ts-node/register/transpile-only -r tsconfig-paths/register prisma/seed.ts --only=user",
    "seed:catalog": "node -r ts-node/register/transpile-only -r tsconfig-paths/register prisma/seed.ts --only=category,products",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@bull-board/nestjs": "^7.1.5",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^10.3.2",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.2",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/client": "^5.9.1",
    "bcrypt": "^5.1.1",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.10.1",
    "nest-winston": "^1.10.2",
    "readme-md-generator": "^1.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.2",
    "@swc/cli": "^0.3.9",
    "@swc/core": "^1.4.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "20.11.17",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "29.7.0",
    "prettier": "^3.2.5",
    "prisma": "^5.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*/__tests__/.*\\.test\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "moduleNameMapper": {
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@decorators/(.*)$": "<rootDir>/decorators/$1",
      "^@helpers/(.*)$": "<rootDir>/helpers/$1",
      "^@constants/(.*)$": "<rootDir>/constants/$1",
      "^@types/(.*)$": "<rootDir>/types/$1",
      "^@utilities/(.*)$": "<rootDir>/utilities/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@interceptor/(.*)$": "<rootDir>/interceptor/$1",
      "^@services/(.*)$": "<rootDir>/services/$1",
      "^@guards/(.*)$": "<rootDir>/guards/$1"
    },
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    }
  },
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "src",
  "testRegex": ".*/__test__/.*\\.test\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "**/*.(t|j)s"
  ],
  "coverageDirectory": "../coverage",
  "moduleNameMapper": {
    "^@modules/(.*)$": "<rootDir>/modules/$1",
    "^@decorators/(.*)$": "<rootDir>/decorators/$1",
    "^@helpers/(.*)$": "<rootDir>/helpers/$1",
    "^@constants/(.*)$": "<rootDir>/constants/$1",
    "^@types/(.*)$": "<rootDir>/types/$1",
    "^@utilities/(.*)$": "<rootDir>/utilities/$1",
    "^@config/(.*)$": "<rootDir>/config/$1",
    "^@interceptor/(.*)$": "<rootDir>/interceptor/$1",
    "^@services/(.*)$": "<rootDir>/services/$1",
    "^@guards/(.*)$": "<rootDir>/guards/$1"
  },
  "testEnvironment": "node"
}
