generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

enum Role {
  user
  admin
}

enum DeliveryStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  FAILED
}

model User {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  firstName       String?           @map("first_name")
  lastName        String?           @map("last_name")
  email           String            @unique
  password        String
  isEmailVerified Boolean           @default(false) @map("is_email_verified")
  role            Role              @default(user)
  userToken       String?           @unique @map("user_token")
  reviews         Review[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  orders          Order[]
  shippingAddress ShippingAddress[]
  cart            Cart[]
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  description String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]
}

model Product {
  id                 String                 @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String
  price              Float
  discountPercentage Float?
  stock              Int                    @default(0)
  isDeleted          Boolean                @default(false) @map("is_deleted")
  brand              String
  thumbnail          String
  images             Image[]
  reviews            Review[]
  category           Category               @relation(fields: [categoryId], references: [id])
  categoryId         String                 @db.ObjectId @map("category_id")
  highlights         ProductHighlight[]
  specifications     ProductSpecification[]
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  orders             OrderProduct[]
  cart               Cart[]
}

model Image {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId @map("product_id")
}

model ProductHighlight {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String   @db.ObjectId @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model ProductSpecification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String   @db.ObjectId @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId @map("product_id")
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId @map("user_id")
  rating    Int
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model ShippingAddress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  street    String
  city      String
  zip       String
  country   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId @map("user_id")
  orders    Order[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Cart {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId @map("product_id")
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId @map("user_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Order {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  user              User            @relation(fields: [userId], references: [id])
  userId            String          @db.ObjectId @map("user_id")
  products          OrderProduct[]
  orderAmount       Float           @map("order_amount")
  shippingAddress   ShippingAddress @relation(fields: [shippingAddressId], references: [id])
  shippingAddressId String          @db.ObjectId @map("shipping_address_id")
  deliveryStatus    DeliveryStatus  @map("delivery_status")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
}

model OrderProduct {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String   @db.ObjectId @map("order_id")
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}
